generator client {
  provider = "prisma-client"
  output   = "../src/generated_prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProjectType {
  REDEVELOPMENT
  RECONSTRUCTION
  OTHER
}

enum TransactionType {
  SALE
  JEONSE
  MONTHLY_RENT
}

enum ListingStatus {
  ACTIVE
  CLOSED
  WITHDRAWN
}

enum SyncStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum NotificationType {
  NEW_LISTING
  PRICE_CHANGED
}

/// 기존 회원 ID를 유지하는 앱 프로필.
/// 비밀번호와 인증 세션은 Supabase Auth에서 관리한다.
model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// 기존 회원은 안전하게 연결하기 전까지 null로 유지한다.
  supabaseAuthId String? @unique @db.Uuid
  avatarUrl      String?

  favoriteRegions FavoriteRegion[]
  notifications   Notification[]

  @@map("users")
}

/// 행정지역 계층. code는 법정동 코드 등 하나의 코드 체계로 통일한다.
model Region {
  id       String  @id @default(uuid()) @db.Uuid
  code     String  @unique
  name     String
  parentId String? @db.Uuid

  parent   Region?  @relation("RegionTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Region[] @relation("RegionTree")

  zones     RedevelopmentZone[]
  listings  PropertyListing[]
  favorites FavoriteRegion[]

  @@index([parentId])
  @@map("regions")
}

/// API·제공기관의 공개 출처 정보. API 키나 비밀 URL은 저장하지 않는다.
model DataSource {
  id           String  @id @default(uuid()) @db.Uuid
  code         String  @unique
  name         String
  provider     String
  referenceUrl String
  licenseNote  String?

  zones       RedevelopmentZone[]
  listings    PropertyListing[]
  stageEvents ZoneStageEvent[]
  syncRuns    DataSyncRun[]

  @@map("data_sources")
}

/// 정비구역 기본 정보. 외부 레코드 ID는 제공처 안에서 유일하다.
model RedevelopmentZone {
  id          String      @id @default(uuid()) @db.Uuid
  name        String
  projectType ProjectType
  regionId    String      @db.Uuid
  address     String?
  latitude    Decimal?    @db.Decimal(10, 7)
  longitude   Decimal?    @db.Decimal(10, 7)
  areaM2      Decimal?    @db.Decimal(16, 2)

  currentStageId String? @db.Uuid
  sourceId       String  @db.Uuid
  externalId     String

  /// 원본에서 제공하는 수정 시각. 제공하지 않으면 null.
  sourceUpdatedAt DateTime? @db.Timestamptz(3)
  /// 마지막으로 원본에서 이 레코드를 확인한 시각.
  lastSeenAt      DateTime  @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  region       Region            @relation(fields: [regionId], references: [id], onDelete: Restrict)
  source       DataSource        @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  currentStage ProjectStage?     @relation(fields: [currentStageId], references: [id], onDelete: Restrict)
  stageEvents  ZoneStageEvent[]
  listings     PropertyListing[]

  @@unique([sourceId, externalId])
  @@index([regionId, projectType])
  @@index([currentStageId])
  @@map("redevelopment_zones")
}

/// 기관별 원본 단계명을 앱 공통 코드로 대응시키는 기준.
/// 실제 코드 목록과 순서는 사용할 데이터셋 확인 후 확정한다.
model ProjectStage {
  id        String @id @default(uuid()) @db.Uuid
  code      String @unique
  name      String
  sortOrder Int

  zones  RedevelopmentZone[]
  events ZoneStageEvent[]

  @@map("project_stages")
}

/// 단계별 인가·고시 이력. 단계가 항상 순방향으로 진행한다고 가정하지 않는다.
model ZoneStageEvent {
  id            String    @id @default(uuid()) @db.Uuid
  zoneId        String    @db.Uuid
  stageId       String    @db.Uuid
  sourceId      String    @db.Uuid
  externalId    String
  sourceLabel   String?
  noticeNumber  String?
  referenceUrl  String?
  effectiveDate DateTime? @db.Date

  sourceUpdatedAt DateTime? @db.Timestamptz(3)
  lastSeenAt      DateTime  @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  zone   RedevelopmentZone @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  stage  ProjectStage      @relation(fields: [stageId], references: [id], onDelete: Restrict)
  source DataSource        @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([sourceId, externalId])
  @@index([zoneId, effectiveDate])
  @@index([stageId])
  @@map("zone_stage_events")
}

/// 실제 제공 권한이 있는 매물 데이터.
/// 실거래 기록은 현재 판매 중인 매물과 구분한다.
model PropertyListing {
  id              String          @id @default(uuid()) @db.Uuid
  title           String
  propertyType    String
  transactionType TransactionType
  status          ListingStatus   @default(ACTIVE)
  regionId        String          @db.Uuid
  zoneId          String?         @db.Uuid
  address         String?
  exclusiveAreaM2 Decimal?        @db.Decimal(12, 2)

  /// 금액 단위는 원. 거래 유형에 필요한 필드만 사용한다.
  salePriceWon   Decimal? @db.Decimal(20, 0)
  depositWon     Decimal? @db.Decimal(20, 0)
  monthlyRentWon Decimal? @db.Decimal(20, 0)

  sourceId     String  @db.Uuid
  externalId   String
  referenceUrl String?

  /// 가격 등 알림 대상 정보가 변할 때 증가시키는 버전.
  revision        Int       @default(1)
  sourceUpdatedAt DateTime? @db.Timestamptz(3)
  lastSeenAt      DateTime  @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  region        Region             @relation(fields: [regionId], references: [id], onDelete: Restrict)
  zone          RedevelopmentZone? @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  source        DataSource         @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  notifications Notification[]

  @@unique([sourceId, externalId])
  @@index([regionId, status, createdAt])
  @@index([zoneId, status])
  @@map("property_listings")
}

/// 행정지역과 그 하위 지역에 대한 사용자 관심 설정.
model FavoriteRegion {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @db.Uuid
  regionId           String   @db.Uuid
  includeDescendants Boolean  @default(true)
  alertsEnabled      Boolean  @default(false)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)

  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  region        Region         @relation(fields: [regionId], references: [id], onDelete: Restrict)
  notifications Notification[]

  @@unique([userId, regionId])
  @@index([regionId, alertsEnabled])
  @@map("favorite_regions")
}

/// 앱 내부 알림. 생성은 실제 전송 성공과 다르다.
model Notification {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String           @db.Uuid
  favoriteRegionId String?          @db.Uuid
  listingId        String           @db.Uuid
  type             NotificationType
  listingRevision  Int
  title            String
  message          String
  readAt           DateTime?        @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)

  user           User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  favoriteRegion FavoriteRegion? @relation(fields: [favoriteRegionId], references: [id], onDelete: SetNull)
  listing        PropertyListing @relation(fields: [listingId], references: [id], onDelete: Restrict)

  /// 관심지역이 겹쳐도 동일 매물의 동일 변경 알림은 한 번만 생성한다.
  @@unique([userId, listingId, type, listingRevision])
  @@index([userId, readAt, createdAt])
  @@index([favoriteRegionId])
  @@index([listingId])
  @@map("notifications")
}

/// 출처별 수집 실행 기록. 원문 응답·비밀값은 저장하지 않는다.
model DataSyncRun {
  id            String     @id @default(uuid()) @db.Uuid
  sourceId      String     @db.Uuid
  status        SyncStatus @default(RUNNING)
  startedAt     DateTime   @default(now()) @db.Timestamptz(3)
  finishedAt    DateTime?  @db.Timestamptz(3)
  fetchedCount  Int        @default(0)
  upsertedCount Int        @default(0)
  errorCode     String?

  source DataSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@index([sourceId, startedAt])
  @@map("data_sync_runs")
}
